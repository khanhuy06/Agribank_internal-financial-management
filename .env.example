# =========================================================
# FILE MẪU CẤU HÌNH MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# Sao chép file này thành .env và điền các giá trị thực tế
# =========================================================

# 1. Cấu hình bảo mật hệ thống
SECRET_KEY=agribank_super_secret_jwt_key_random_2026_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 2. Cấu hình Database (Hỗ trợ PostgreSQL hoặc Turso hoặc SQLite)
# Khi dùng Docker Compose / VPS:
# DATABASE_URL=postgresql://agribank_user:agribank_pass@db:5432/agribank_db
# Khi dùng trên Cloud Render/Neon/Supabase:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Khi để trống: Hệ thống tự động dùng SQLite cục bộ hoặc Turso Cloud
DATABASE_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 3. Cấu hình Máy chủ Web
PORT=8000
HOST=0.0.0.0

# 4. Cấu hình Gửi Email (Hỗ trợ 2 cách, nếu để trống sẽ in OTP mô phỏng ra Console)
# Cách 1 (Khuyên dùng khi deploy Cloud/Vercel): Điền API key từ Resend.com (bắt đầu bằng re_...)
RESEND_API_KEY=re_123456789...

# Cách 2: Dùng Gmail SMTP truyền thống (cổng 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=Agribank Hoàn Lão <no-reply@agribank.com.vn>
